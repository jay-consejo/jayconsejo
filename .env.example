# Copy to .env.local and fill in. All values are server-only; never prefix them with NEXT_PUBLIC_.

# ElevenLabs voice agent, used by /api/sofia/sign to mint signed call URLs.
# The API key needs the convai_write permission.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Voice provider for /api/sofia/sign. Unset = ElevenLabs; "nova" = our own voice relay.
SOFIA_PROVIDER=
# The relay's call socket, e.g. ws://localhost:8787/call locally. Its health check is
# derived from it (/call -> /health). On a Vercel preview, /api/sofia/sign also accepts that
# preview's own URLs (from Vercel's VERCEL_URL and VERCEL_BRANCH_URL); the relay must list the
# same origin in its PREVIEW_ORIGINS before a preview call can connect.
SOFIA_RELAY_URL=
# Shared with the relay, which verifies the call tickets this app signs. 32+ characters.
SOFIA_TICKET_SECRET=

# Call logger (Google Apps Script web app /exec URL) and its shared key.
# Optional: when unset, the repeat-caller check is skipped.
SOFIA_LOGGER_URL=
SOFIA_LOGGER_API_KEY=
