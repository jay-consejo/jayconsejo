# Copy to .env.local and fill in. All values are server-only; never prefix them with NEXT_PUBLIC_.

# ElevenLabs voice agent, used by /api/sofia/sign to mint signed call URLs.
# The API key needs the convai_write permission.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Call logger (Google Apps Script web app /exec URL) and its shared key.
# Optional: when unset, the repeat-caller check is skipped.
SOFIA_LOGGER_URL=
SOFIA_LOGGER_API_KEY=
