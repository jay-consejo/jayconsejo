# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local session tracking + process docs (never committed — not needed to run the site)
/journal
/standups
/PROGRESS.md
/DECISIONS.md
/JOURNAL.md

# local tooling state (not needed to run the site)
/.claude
/.alex-sync

# local-only backup of untracked-but-kept files (never committed)
/local-backup

# non-runtime docs & AI instructions (kept local, not pushed)
/CLAUDE.md
/AGENTS.md
/README.md
/docs
/design-proposals
/pipeline-responses
